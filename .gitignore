.vercel
.env*
node_modules/

# Datos personales para crear cuentas en lote (npm run usuarios:lote)
bd/*.local.json

# Salidas de las pruebas de navegador (vídeos, trazas, capturas, informe HTML)
pruebas/e2e/informe/
pruebas/e2e/resultados/

# Skills de agentes para otros harnesses (Codex, Gemini, etc.)
.agents/

# Binarios de skills (motor impeccable y similares)
*.exe
*.dll
*.so
*.dylib
*.node
.claude/skills/**/scripts/bin/

# Respaldos de la base: datos personales y de salud, nunca al repositorio
respaldos/
# Registros de la API cuando corre bajo XAMPP (xampp/servicio_api.js)
logs/
